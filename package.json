{
  "name": "tado",
  "version": "0.1.0",
  "description": "Deterministic workflow engine for LLM agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:t-miura-024/tado"
  },
  "bin": {
    "tado": "./src/cli/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/types/index.ts",
    "./prompt": "./src/prompt.ts",
    "./types/*": "./src/types/*"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.15.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^6.2.5"
  }
}
