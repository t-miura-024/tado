{
  "name": "tado",
  "version": "0.1.0",
  "description": "Deterministic workflow engine for LLM agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:t-miura-024/tado"
  },
  "bin": {
    "tado": "./src/cli/main.ts"
  },
  "type": "module",
  "exports": {
    "./prompt": "./src/prompt.ts",
    "./types/*": "./src/types/*"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  }
}
